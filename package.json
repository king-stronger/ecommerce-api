{
	"name": "ecommerce-api",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "tsx src/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "pnpm dlx auth@1.7.5 generate --config ./src/auth.ts --output ./src/db/schemas/auth.ts --yes --adapter drizzle --dialect postgresql",
		"format": "biome format --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@hono/structured-logger": "^0.1.0",
		"@hono/zod-openapi": "^1.5.1",
		"@neondatabase/serverless": "^1.2.0",
		"@scalar/hono-api-reference": "^0.11.12",
		"better-auth": "^1.7.5",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^1000.0.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.33",
		"stoker": "^2.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@cloudflare/workers-types": "^5.20261104.1",
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"wrangler": "^4.157.0"
	}
}
